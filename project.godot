; Engine configuration file.
; Pac-Man Online - Godot 4 web client.

config_version=5

[application]

config/name="PAC-MAN Online"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
boot_splash/show_image=false

[display]

window/size/viewport_width=1000
window/size/viewport_height=680
window/size/window_width_override=1000
window/size/window_height_override=680
window/size/resizable=true
window/size/initial_position_type=1
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0196078, 0.0235294, 0.0470588, 1)

[audio]

driver/enable_input=false
